{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": false },
  "formatter": { "enabled": true, "indentStyle": "tab" },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "a11y": {
        "noAriaUnsupportedElements": "warn",
        "useAltText": "warn",
        "useAriaPropsForRole": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useValidAriaProps": "warn",
        "useValidAriaValues": "warn"
      },
      "complexity": {
        "noArguments": "error",
        "noUselessTypeConstraint": "error"
      },
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "warn",
        "noChildrenProp": "error",
        "noConstAssign": "off",
        "noGlobalObjectCalls": "off",
        "noInvalidBuiltinInstantiation": "off",
        "noInvalidConstructorSuper": "off",
        "noNextAsyncClientComponent": "warn",
        "noRenderReturnValue": "error",
        "noSetterReturn": "off",
        "noUndeclaredVariables": "off",
        "noUnreachable": "off",
        "noUnreachableSuper": "off",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": false,
            "ignoreUsingDeclarations": false
          }
        },
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "useInlineScriptId": "error",
        "useJsxKeyInIterable": "error"
      },
      "performance": {
        "noImgElement": "warn",
        "noSyncScripts": "warn",
        "noUnwantedPolyfillio": "warn",
        "useGoogleFontPreconnect": "warn"
      },
      "security": { "noDangerouslySetInnerHtmlWithChildren": "error" },
      "style": {
        "noCommonJs": "error",
        "noHeadElement": "warn",
        "noNamespace": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useConst": "error",
        "useSpreadOverApply": "error"
      },
      "suspicious": {
        "noClassAssign": "off",
        "noCommentText": "error",
        "noDocumentImportInPage": "error",
        "noDuplicateClassMembers": "off",
        "noDuplicateEnumValues": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "off",
        "noDuplicateParameters": "off",
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noFunctionAssign": "off",
        "noHeadImportInDocument": "error",
        "noImportAssign": "off",
        "noMisleadingInstantiator": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noReactStringRefs": "error",
        "noRedeclare": "off",
        "noUnknownAttribute": "error",
        "noUnsafeDeclarationMerging": "error",
        "noUnsafeNegation": "off",
        "noUnusedExpressions": "off",
        "noVar": "error",
        "noWith": "off",
        "useGetterReturn": "off",
        "useGoogleFontDisplay": "warn",
        "useNamespaceKeyword": "error"
      }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" },
    "globals": [
      "onanimationend",
      "onstorage",
      "ondragend",
      "exports",
      "onloadeddata",
      "onlostpointercapture",
      "onanimationiteration",
      "onfocus",
      "onkeyup",
      "onmousedown",
      "onoffline",
      "onplay",
      "onafterprint",
      "onanimationstart",
      "onprogress",
      "onpause",
      "onended",
      "onclick",
      "onpointerover",
      "onmouseout",
      "onloadstart",
      "oncanplay",
      "ondblclick",
      "onappinstalled",
      "onpointermove",
      "ontoggle",
      "ondrag",
      "onchange",
      "oncontextmenu",
      "onmessage",
      "onblur",
      "onabort",
      "onpointerdown",
      "onbeforeinstallprompt",
      "oncancel",
      "onbeforeprint",
      "onpointerout",
      "oncuechange",
      "ongotpointercapture",
      "onsearch",
      "onsubmit",
      "onloadedmetadata",
      "onpointerup",
      "onstalled",
      "onlanguagechange",
      "onreset",
      "onsuspend",
      "onerror",
      "onmouseenter",
      "onscroll",
      "onload",
      "onresize",
      "onmouseover",
      "ondragover",
      "ondragstart",
      "oninput",
      "onpagehide",
      "oncanplaythrough",
      "onmousemove",
      "oninvalid",
      "ontimeupdate",
      "onratechange",
      "ondurationchange",
      "onmouseup",
      "onmessageerror",
      "ondevicemotion",
      "onkeypress",
      "onwheel",
      "onpointerleave",
      "location",
      "onauxclick",
      "ononline",
      "onselect",
      "ondrop",
      "onkeydown",
      "onclose",
      "ondeviceorientationabsolute",
      "ontransitionend",
      "onpageshow",
      "ondeviceorientation",
      "onseeking",
      "OffscreenCanvas",
      "onpointercancel",
      "onunload",
      "onmouseleave",
      "onrejectionhandled",
      "ondragleave",
      "onseeked",
      "onhashchange",
      "onwaiting",
      "onpointerenter",
      "onunhandledrejection",
      "ondragenter",
      "onpopstate",
      "onmousewheel",
      "onemptied",
      "onbeforeunload",
      "onplaying",
      "onvolumechange"
    ]
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}
