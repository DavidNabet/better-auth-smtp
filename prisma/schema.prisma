generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES")
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  MEMBER
  USER
}

model User {
  id                 String          @id @default(cuid())
  email              String
  name               String?         @unique
  emailVerified      Boolean
  image              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  twoFactorEnabled   Boolean?        @default(false)
  notificationStatus Boolean         @default(false)
  role               Role            @default(USER)
  banned             Boolean?        @default(false)
  banReason          String?
  banExpires         DateTime?
  sessions           Session[]
  accounts           Account[]
  members            Member[]
  invitations        Invitation[]
  teamMembers        TeamMember[]
  twofactors         TwoFactor[]
  notifications      Notification[]
  // relations
  feedbacks          Feedback[]
  votes              Vote[]
  comments           Comment[]
  likes              Like[]
  moderationLogs     ModerationLog[]

  @@unique([email])
  @@map("user")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  impersonatedBy String?

  activeOrganizationId String?
  activeTeamId         String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String?
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  teams       Team[]
  apps        App[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  teamId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Team {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  description    String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberCount    Int          @default(0)
  slug           String?
  logo           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  teamMembers    TeamMember[]
  apps           App[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id            String    @id @default(cuid())
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  membershipKey String?
  createdAt     DateTime? @default(now())

  @@unique([membershipKey])
  @@index([teamId])
  @@index([userId])
  @@map("teamMember")
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String
  teamId         String?
  actorId        String
  type           String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())
  // organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("activity")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

enum CommentAction {
  HIDE_COMMENT
  DELETE_COMMENT
  WARN_COMMENT
}

model ModerationLog {
  id        String        @id @default(cuid())
  action    CommentAction @default(WARN_COMMENT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  moderatorId String
  commentId   String?

  moderator User @relation(fields: [moderatorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("moderationLog")
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  type           String
  title          String
  body           String?
  href           String?
  data           Json?
  read           Boolean  @default(false)
  createdAt      DateTime

  @@map("notification")
}

